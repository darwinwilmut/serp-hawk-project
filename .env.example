# Copy this file to .env and fill in all values before running docker compose

# ── PostgreSQL (Docker Compose internal) ────────────────────────────────────
POSTGRES_USER=crmuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crmdb

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Email / SMTP (Outlook) ───────────────────────────────────────────────────
SENDER_EMAIL=noreply@yourdomain.com
SENDER_PASSWORD=your-outlook-app-password
EMAIL_SENDER=noreply@yourdomain.com
EMAIL_PASSWORD=your-outlook-app-password

# ── AWS S3 (file uploads) ────────────────────────────────────────────────────
S3_BUCKET_NAME=serphawk-crm-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── CORS ─────────────────────────────────────────────────────────────────────
# The public URL of the frontend (no trailing slash)
FRONTEND_ORIGIN=https://yourdomain.com

# ── Frontend build arg (baked into Next.js image at build time) ──────────────
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api
